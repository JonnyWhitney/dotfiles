layout {
    pane size=1 borderless=true {
        plugin location="file:~/.config/zellij/zjstatus.wasm" {
            format_left "#[fg=#00ffff,bg=#26314D] {session}  {mode}#[bg=#26314D] {tabs}"
            format_right "#[fg=#a9b1d6,bg=#26314D] {swap_layout} #[fg=#a9b1d6,bg=#26314D] {datetime}"
            format_space "#[fg=#a9b1d6,bg=#26314D]"
            mode_normal "#[fg=#1a1b26,bg=#7aa2f7] {name} "
            mode_locked "#[fg=#1a1b26,bg=#f7768e] {name} "
            mode_resize "#[fg=#1a1b26,bg=#bb9af7] {name} "
            mode_scroll "#[fg=#1a1b26,bg=#9ece6a] {name} "
            mode_enter_search "#[fg=#1a1b26,bg=#73b25a] {name} "
            mode_search "#[fg=#1a1b26,bg=#73daca] {name} "
            mode_move "#[fg=#1a1b26,bg=#ff9e64] {name} "
            mode_rename_pane "#[fg=#1a1b26,bg=#e8c07e] {name} "
            mode_rename_tab "#[fg=#1a1b26,bg=#c96e2d] {name} "
            tab_normal "#[fg=#737aa2,bg=#26314D] {index} - {name} "
            tab_active "#[fg=#c0caf5,bg=#414868,bold] {index} - {name} "
            datetime "#[fg=#6C7086,bold,bg=#26314D] {format} "
            datetime_format "%A, %d %b %Y %I:%M:%S%p"
            datetime_timezone "US/Eastern"
        }
    }
    pane
    swap_floating_layout name="FLOATING" {
        floating_panes max_panes=1 {
            pane x="2%" y="2%" width="96%" height="92%"
        }
        floating_panes max_panes=2 {
            pane x="2%" y="2%" width="46%" height="92%"
            pane x="52%" y="2%" width="46%" height="92%"
        }
        floating_panes max_panes=3 {
            pane x="2%" y="2%" width="30%" height="92%"
            pane x="35%" y="2%" width="30%" height="92%"
            pane x="68%" y="2%" width="30%" height="92%"
        }
    }
}

